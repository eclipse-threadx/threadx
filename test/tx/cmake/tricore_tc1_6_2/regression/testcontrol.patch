Test memory of testcontrol.c for the TC375 Lite Kit.

The two arrays of 0x60000 bytes each do not fit the RAM of the TC375. The
largest test uses about 94 KiB of tests_memory, and the test control uses
three stacks of TEST_STACK_SIZE bytes from test_control_memory. Both arrays
go to DSPR1 (.bss_cpu1 in bsp/regression.ld).

--- a/test/tx/regression/testcontrol.c
+++ b/test/tx/regression/testcontrol.c
@@ -118,8 +118,8 @@
 VOID            (*test_isr_dispatch)(void);
 
 
-UCHAR           test_control_memory[0x60000];
-UCHAR           tests_memory[0x60000];
+UCHAR           test_control_memory[0x6000] __attribute__((section(".bss_cpu1")));
+UCHAR           tests_memory[0x1C000] __attribute__((section(".bss_cpu1")));
 
 /* Define the external reference for the preempt disable flag.  */
 
