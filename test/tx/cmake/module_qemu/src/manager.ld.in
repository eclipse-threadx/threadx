/* MPS2 places code and data in SSRAM. MPS3 AN547 uses ITCM and DTCM.
   The manager's RAM ends at the start of the shared area.  */

MEMORY
{
    CODE (rx)  : ORIGIN = 0x00000000, LENGTH = @MANAGER_CODE_LENGTH@
    RAM  (rwx) : ORIGIN = 0x20000000, LENGTH = @MANAGER_RAM_LENGTH@
}

ENTRY(reset_handler)

SECTIONS
{
    .vectors :
    {
        KEEP(*(.vectors))
    } > CODE

    .text :
    {
        *(.text .text.*)
        *(.rodata .rodata.*)
        . = ALIGN(4);
    } > CODE

    .ARM.exidx :
    {
        *(.ARM.exidx*)
    } > CODE

    __data_load_start__ = LOADADDR(.data);

    .data : ALIGN(4)
    {
        __data_start__ = .;
        *(.data .data.*)
        . = ALIGN(4);
        __data_end__ = .;
    } > RAM AT > CODE

    .bss (NOLOAD) : ALIGN(4)
    {
        __bss_start__ = .;
        *(.bss .bss.*)
        *(COMMON)
        . = ALIGN(4);
        __bss_end__ = .;
    } > RAM

    .stack (NOLOAD) : ALIGN(8)
    {
        __stack_start__ = .;
        . = . + 2048;
        __stack_end__ = .;
    } > RAM

    __RAM_segment_used_end__ = .;
}
