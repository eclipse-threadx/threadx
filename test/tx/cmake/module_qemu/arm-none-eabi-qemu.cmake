# Toolchain for the module execution harness.
#
# Deliberately not cmake/cortex_m3.cmake or cmake/cortex_m4.cmake.  Those add
# -mlong-calls to every C file, and under -fpic that routes every call in a
# module through its GOT, including the shell entry's call to the function that
# fills the GOT in; and they leave the floating-point unit off, which the
# Cortex-M4 module port needs on to exercise its lazy-stacking paths.  The CPU
# and FPU flags are chosen per port in CMakeLists.txt instead.

set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)

set(CMAKE_C_COMPILER   arm-none-eabi-gcc)
set(CMAKE_ASM_COMPILER arm-none-eabi-gcc)
set(CMAKE_OBJCOPY      arm-none-eabi-objcopy CACHE FILEPATH "objcopy")

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

# Compiler checks build a static library, so they need no startup code or
# linker script.
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
